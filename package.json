{
  "name": "varath-world",
  "version": "0.1.0",
  "description": "Varath World - a 2D top-down, tile-based, OSRS-style world game.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "shots": "npm run build && tsx tools/shots.ts",
    "shots:only": "tsx tools/shots.ts",
    "sheet": "npm run build && tsx tools/sheet.ts",
    "sheet:only": "tsx tools/sheet.ts",
    "perf": "tsx tools/perf.ts",
    "sim:appearance": "tsx sims/appearance.ts",
    "sim:art": "tsx sims/art.ts",
    "sim:bonus": "tsx sims/bonus.ts",
    "sim:camps": "tsx sims/camps.ts",
    "sim:collection": "tsx sims/collection.ts",
    "sim:death": "tsx sims/death.ts",
    "sim:feats": "tsx sims/feats.ts",
    "sim:ironman": "tsx sims/ironman.ts",
    "sim:mastery": "tsx sims/mastery.ts",
    "sim:rates": "tsx sims/rates.ts",
    "sim:routines": "tsx sims/routines.ts",
    "sim:status": "tsx sims/status.ts",
    "sim:styles": "tsx sims/styles.ts",
    "sim:thieving": "tsx sims/thieving.ts",
    "sim:tick": "tsx sims/tick.ts",
    "sim:towns": "tsx sims/towns.ts",
    "sim:ttk": "tsx sims/ttk.ts",
    "sim:world": "tsx sims/world.ts",
    "sim:zones": "tsx sims/zones.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
